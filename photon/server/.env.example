APP_ENV=development
SECRET_KEY=
API_KEY=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=yasml
POSTGRES_USER=yasml
POSTGRES_PASSWORD=yasml_secret

REDIS_URL=redis://localhost:6379/0

QDRANT_HOST=localhost
QDRANT_PORT=6333

GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_CHAT_MODEL=

VOYAGE_API_KEY=

GITHUB_TOKEN=

REPOS_STORAGE_PATH=./data/repos

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
SARVAM_API_KEY=

OPENROUTER_API_KEY=

# GitHub App — bootstrap via /dev/github-app/new (dev-only route) rather
# than filling these in by hand.
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=

# Agent jobs — the harness service (`python -m harness.service`, started by
# scripts/dev.sh). HARNESS_SERVICE_TOKEN must be the same value the service
# runs with; AI_API_KEY is the model key the harness uses for its runs.
HARNESS_SERVICE_URL=http://127.0.0.1:8765
HARNESS_SERVICE_TOKEN=
AI_API_KEY=
# A GitHub issue with this label, assigned to a member, goes to their agent.
AGENT_FIX_LABEL=photon-fix
