LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Also derives this worker's brain-api credential (service_auth.py), so it must
# match server/.env. Set WORKER_SERVICE_TOKEN in both instead to decouple them.
WORKER_SERVICE_TOKEN=
DEEPGRAM_API_KEY=

BRAIN_API_URL=http://localhost:8000

# Voice stack: deepgram (default) or sarvam. Switches STT and TTS together.
VOICE_STACK=deepgram
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_STT_MODEL=saaras:v3
